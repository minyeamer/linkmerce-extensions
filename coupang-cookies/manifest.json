{
  "manifest_version": 3,
  "name": "Coupang Cookies",
  "version": "1.0.3",
  "description": "쿠팡 Wing 로그인으로 광고센터까지 확인하고 두 서비스의 쿠키를 Slack에 전송합니다",
  "permissions": [
    "cookies",
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://wing.coupang.com/*",
    "https://advertising.coupang.com/*",
    "https://slack.com/*",
    "https://files.slack.com/*",
    "https://xauth.coupang.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
